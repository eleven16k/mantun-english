# ─── AI provider 1: OpenAI-compatible gateway (primary) ───
# Vision + reasoning model for photo solve (/solve), scenario NPC chat,
# briefing vocab, and Word Quest questions.
# LLM_BASE_URL=https://zm.oxsm.gz.cn/api/v1
# LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=
# Scenario TTS on the gateway (returns PCM16 24kHz; qwen default — fastest
# value; gemini-3.1-flash-tts-preview also works but ~2× slower. Gemini
# direct TTS is the fallback)
# LLM_TTS_MODEL=qwen/qwen-audio-3.0-tts-plus

# ─── AI provider 2: Gemini (fallback if LLM_API_KEY unset) ───
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-flash-latest / gemini-2.5-flash-preview-tts)
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ─── Scenario voice calls (speech-to-speech engine) ───
# Start the engine:  pip install speech-to-speech && speech-to-speech serve
# It exposes an OpenAI Realtime-compatible WS at ws://localhost:8765/v1/realtime.
# For phone/LAN access, point this at the Mac's LAN address:
# NEXT_PUBLIC_S2S_URL=ws://192.168.x.x:8765/v1/realtime
# PCM output rate the server emits (16 kHz local pipeline default; use 24000
# only if your realtime server runs OpenAI-native 24 kHz output):
# NEXT_PUBLIC_S2S_OUTPUT_RATE=16000

# ─── DeepTutor sidecar (AI import) ───
# NEXT_PUBLIC_DEEPTUTOR_URL=http://localhost:18081

# ─── Auth ───
# JWT_SECRET=change-me

# ─── 会员开通申请：展示给用户的管理员联系邮箱 ───
# NEXT_PUBLIC_SUPPORT_EMAIL=admin@example.com

# ─── Org layer branding (机构/学校/校区) ───
# NEXT_PUBLIC_ORG_LABEL=学校
